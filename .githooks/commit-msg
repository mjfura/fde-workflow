#!/usr/bin/env bash
# git-workflow: validate the commit message and the current branch name.
# Installed by ~/.claude/skills/git-workflow/scripts/setup.sh (core.hooksPath=.githooks).
set -eu

TYPES='feat|fix|docs|refactor|test|chore|ci|perf'
MAX_SUBJECT=72

msg_file="$1"
fail() { printf 'commit-msg: %s\n' "$1" >&2; exit 1; }

# Subject = first non-comment, non-blank line.
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1 || true)
[ -n "$subject" ] || fail 'empty commit message.'

# AI attribution is never allowed (Co-Authored-By trailers, session links, "Generated with" lines).
if grep -v '^#' "$msg_file" | grep -qiE '^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with .*claude'; then
  fail 'AI attribution found (Co-Authored-By/Claude-Session/"Generated with"). Remove it.'
fi

# Subjects generated by git itself are accepted as-is.
if printf '%s' "$subject" | grep -qE '^(Merge |Revert "|fixup! |squash! |amend! )'; then
  exit 0
fi

if ! printf '%s' "$subject" | grep -qE "^($TYPES)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ].*[^.]$"; then
  fail "subject must be '<type>(<scope>): <summary>' with type in {${TYPES//|/, }}, no trailing period.
  got: $subject"
fi

[ "${#subject}" -le "$MAX_SUBJECT" ] || fail "subject is ${#subject} chars; keep it <= $MAX_SUBJECT."

# Branch naming (skipped on detached HEAD, e.g. during a rebase).
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ -n "$branch" ] && [ "$branch" != main ]; then
  if ! printf '%s' "$branch" | grep -qE "^(($TYPES)/[a-z0-9]+(-[a-z0-9]+)*|release/v[0-9]+\.[0-9]+)$"; then
    fail "branch '$branch' does not follow '<type>/<kebab-case>' (or 'release/vX.Y'). Rename: git branch -m <type>/<name>"
  fi
fi

exit 0
