#!/usr/bin/env bash
# git-workflow: block direct pushes to main and pushes of badly named branches.
# Installed by ~/.claude/skills/git-workflow/scripts/setup.sh (core.hooksPath=.githooks).
set -eu

TYPES='feat|fix|docs|refactor|test|chore|ci|perf'
ZERO='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # tags etc. are fine
  [ "$local_sha" = "$ZERO" ] && continue                         # branch deletion
  branch=${remote_ref#refs/heads/}

  if [ "$branch" = main ]; then
    # Allow only the very first push that creates main on the remote (bootstrap).
    if [ "$remote_sha" != "$ZERO" ]; then
      echo "pre-push: direct pushes to main are not allowed; push a work branch and open a PR." >&2
      status=1
    fi
    continue
  fi

  if ! printf '%s' "$branch" | grep -qE "^(($TYPES)/[a-z0-9]+(-[a-z0-9]+)*|release/v[0-9]+\.[0-9]+)$"; then
    echo "pre-push: branch '$branch' does not follow '<type>/<kebab-case>' (or 'release/vX.Y')." >&2
    status=1
  fi
done

exit "$status"
